{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-start.js"],
            "timeoutMs": 15000,
            "statusMessage": "cerebro: injecting memories…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/user-prompt-submit.js"],
            "timeoutMs": 10000,
            "statusMessage": "cerebro: recall check…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|Bash",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pre-tool-use.js"],
            "timeoutMs": 10000,
            "statusMessage": "cerebro: checking tool…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/stop.js"],
            "timeoutMs": 30000,
            "statusMessage": "cerebro: saving session memories…"
          }
        ]
      }
    ]
  }
}
